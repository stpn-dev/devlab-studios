{
  "name": "devlab-studios",
  // Custom entrypoint (src/worker.ts) rather than @astrojs/cloudflare's
  // generated one: the generated entrypoint cannot export a Durable Object
  // class, and a DO must be exported from the Worker's entrypoint to be
  // bound. src/worker.ts delegates every request to Astro's own handle()
  // unchanged and only adds the DO export. Both environments share it —
  // there is deliberately no per-environment `main` override below. See
  // docs/architecture/decisions/0006-pickleball-durable-objects.md.
  "main": "./src/worker.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "images": {
    "binding": "IMAGES"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "devlab-studios-cms",
      "database_id": "6ff5e313-51a4-43d5-a649-678eeff1ff25",
      "migrations_dir": "migrations"
    },
    {
      "binding": "PICKLEBALL_DB",
      "database_name": "devlab-pickleball",
      "database_id": "1ca87dbc-beef-492f-8251-058ff2794820",
      "migrations_dir": "migrations/pickleball"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA_BUCKET",
      "bucket_name": "devlab-studios"
    }
  ],
  // One Durable Object per Open Play session, keyed by session id, so two
  // simultaneous court assignments are serialized by construction rather than
  // by client-side button-disabling. D1 stays the source of truth.
  "durable_objects": {
    "bindings": [
      { "name": "SESSION_COORDINATOR", "class_name": "SessionCoordinatorDO" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["SessionCoordinatorDO"] }
  ],
  "vars": {
    "ADMIN_AUTH_MODE": "password",
    "R2_PUBLIC_BASE_URL": "https://pub-401ca3448c3348158cdb3e4e9a9dcb20.r2.dev",
    "TURNSTILE_SITE_KEY": "0x4AAAAAAEO3GbzGXQvAtOdI",
    "RESEND_FROM_EMAIL": "hello@devlabstudios.com",
    "LEAD_NOTIFICATION_EMAIL": "hello@devlabstudios.com",
    "PICKLEBALL_OAUTH_REDIRECT_BASE_URL": "https://www.devlabstudios.com",
    "GOOGLE_OAUTH_CLIENT_ID": "REPLACE_ME"
  },
  "compatibility_date": "2026-03-10",
  "compatibility_flags": ["nodejs_compat"],

  // Preview: a fully separate Worker/D1/R2 so it can never read, write, or
  // leak production content, leads, or secrets. `wrangler deploy --env
  // preview` alone does NOT work here — @astrojs/cloudflare's build step
  // bakes bindings into dist/server/wrangler.json at `astro build` time,
  // before `wrangler deploy` ever runs, so the env flag arrives too late.
  // The build itself must be told which environment to bake in via
  // CLOUDFLARE_ENV=preview (confirmed by inspecting the generated
  // dist/server/wrangler.json with and without it — only the env var
  // changes which bindings get baked in). See docs/deployment.md
  // ("Preview environment setup") for the full one-time setup + the
  // exact build/deploy commands.
  "env": {
    "preview": {
      "name": "devlab-studios-preview",
      "vars": {
        "ADMIN_AUTH_MODE": "password",
        "R2_PUBLIC_BASE_URL": "https://pub-2450236b7cbf4d68aa4bc07f9b606e29.r2.dev",
        "TURNSTILE_SITE_KEY": "0x4AAAAAAEO0gy1ZeS8AbYUC",
        "PICKLEBALL_OAUTH_REDIRECT_BASE_URL": "https://devlab-studios-preview.stpnrey-agustinez.workers.dev",
        "GOOGLE_OAUTH_CLIENT_ID": "REPLACE_ME"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "devlab-studios-cms-preview",
          "database_id": "3e01246b-fe41-4bb4-b667-30fa964ba82b",
          "migrations_dir": "migrations"
        },
        {
          "binding": "PICKLEBALL_DB",
          "database_name": "devlab-pickleball-preview",
          "database_id": "9f1687d1-dd5a-4a96-9fad-0ce93f49da12",
          "migrations_dir": "migrations/pickleball"
        }
      ],
      "r2_buckets": [
        {
          "binding": "MEDIA_BUCKET",
          "bucket_name": "devlab-studios-preview"
        }
      ],
      // Unlike D1/R2, a Durable Object needs no separate physical resource per
      // environment: the same class_name is correct here, and Cloudflare keeps
      // preview and production DO storage apart by Worker name.
      "durable_objects": {
        "bindings": [
          { "name": "SESSION_COORDINATOR", "class_name": "SessionCoordinatorDO" }
        ]
      },
      "migrations": [
        { "tag": "v1", "new_sqlite_classes": ["SessionCoordinatorDO"] }
      ]
    }
  }
}
