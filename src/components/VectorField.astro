---
import {
  Robot,
  Code2,
  Cpu,
  Database,
  GitBranch,
  Globe,
  Network,
  Server,
  Sparkles,
  Webhook,
} from './icons/icons.js'

interface Props {
  motif?: 'fullstack' | 'automation' | 'data' | 'editorial'
  class?: string
}

const { motif = 'fullstack', class: className = '' } = Astro.props

const groups = {
  fullstack: [Globe, Code2, Server, Database, GitBranch, Cpu],
  automation: [Webhook, Robot, Network, Sparkles, GitBranch, Cpu],
  data: [Database, Server, Network, Webhook, Cpu, GitBranch],
  editorial: [Code2, Globe, Sparkles, Network, Database, Robot],
}

const icons = groups[motif] || groups.fullstack
---

<div class={`vector-field vector-field--${motif} ${className}`} aria-hidden="true">
  <div class="vector-field__grid"></div>
  <div class="vector-field__orbit vector-field__orbit--one"></div>
  <div class="vector-field__orbit vector-field__orbit--two"></div>
  {icons.map((Icon, index) => (
    <span class={`vector-field__icon vector-field__icon--${index + 1}`}>
      <Icon className="h-5 w-5" strokeWidth={1.35} />
    </span>
  ))}
</div>
