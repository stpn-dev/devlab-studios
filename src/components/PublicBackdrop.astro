---
import { Code2, Cpu, Database, GitBranch, Network, Server, Webhook } from './icons/icons.js'

const markers = [
  { Icon: Database, className: 'public-backdrop__marker--one' },
  { Icon: Code2, className: 'public-backdrop__marker--two' },
  { Icon: Network, className: 'public-backdrop__marker--three' },
  { Icon: Cpu, className: 'public-backdrop__marker--four' },
  { Icon: GitBranch, className: 'public-backdrop__marker--five' },
  { Icon: Server, className: 'public-backdrop__marker--six' },
  { Icon: Webhook, className: 'public-backdrop__marker--seven' },
]
---

<div class="public-backdrop" aria-hidden="true">
  <span class="public-backdrop__orbit public-backdrop__orbit--one"></span>
  <span class="public-backdrop__orbit public-backdrop__orbit--two"></span>
  <span class="public-backdrop__orbit public-backdrop__orbit--three"></span>
  {markers.map(({ Icon, className }) => (
    <span class={`public-backdrop__marker ${className}`}>
      <Icon className="h-5 w-5" strokeWidth={1.25} />
    </span>
  ))}
</div>
