---
import {
  Robot,
  Code2,
  Database,
  Globe,
  MessageSquare,
  Server,
  Webhook,
} from './icons/icons.js'

const defaultNodes = [
  { key: 'visitor', label: 'Visitor / Lead', note: 'Intent captured', icon: Globe },
  { key: 'interface', label: 'Web Interface', note: 'React + Astro', icon: Code2 },
  { key: 'backend', label: 'API Service', note: 'Java + Laravel', icon: Server },
  { key: 'data', label: 'Structured Data', note: 'SQL + D1', icon: Database },
  { key: 'decision', label: 'AI Decision', note: 'Qualify + route', icon: Robot },
  { key: 'automation', label: 'Automation', note: 'n8n + Make', icon: Webhook },
  { key: 'handoff', label: 'Human Handoff', note: 'CRM + response', icon: MessageSquare },
]

const { contentNodes = [], statusLabel = 'System online' } = Astro.props
const configuredNodes = Array.isArray(contentNodes) ? contentNodes : []
const nodes = defaultNodes.map((node) => {
  const configured = configuredNodes.find((item) => item?.key === node.key)
  return configured
    ? { ...node, label: String(configured.label || node.label), note: String(configured.note || node.note) }
    : node
})
---

<div class="living-system" data-living-system aria-label="A full-stack and automation system from visitor to human handoff">
  <div class="living-system__ambient" aria-hidden="true"></div>
  <div class="living-system__path" aria-hidden="true">
    {Array.from({ length: 6 }).map((_, index) => <span class={`living-system__line living-system__line--${index + 1}`}></span>)}
  </div>
  <div class="living-system__nodes">
    {nodes.map((node, index) => (
      <div class={`living-system__node living-system__node--${node.key}`} style={`--node-delay:${index * 90}ms`}>
        <span class="living-system__node-icon" aria-hidden="true">
          <node.icon className="h-4 w-4" strokeWidth={1.8} />
        </span>
        <span>
          <strong>{node.label}</strong>
          <small>{node.note}</small>
        </span>
      </div>
    ))}
  </div>
  <div class="living-system__status" aria-hidden="true">
    <span></span>
    {statusLabel}
  </div>
</div>

<script>
  const systems = document.querySelectorAll<HTMLElement>('[data-living-system]')
  const finePointer = window.matchMedia('(pointer: fine)')
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)')

  if (finePointer.matches && !reducedMotion.matches) {
    systems.forEach((system) => {
      system.addEventListener('pointermove', (event) => {
        const rect = system.getBoundingClientRect()
        const x = ((event.clientX - rect.left) / rect.width - 0.5) * 2
        const y = ((event.clientY - rect.top) / rect.height - 0.5) * 2
        system.style.setProperty('--system-x', `${x * 8}px`)
        system.style.setProperty('--system-y', `${y * 8}px`)
      })
      system.addEventListener('pointerleave', () => {
        system.style.setProperty('--system-x', '0px')
        system.style.setProperty('--system-y', '0px')
      })
    })
  }
</script>
