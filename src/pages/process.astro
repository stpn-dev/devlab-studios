---
import Layout from '../layouts/Layout.astro'
import BlockRenderer from '../components/blocks/BlockRenderer.astro'
import { loadPage } from '../lib/content/pages'
import { loadPageSeo } from '../lib/content/seo'

const seo = await loadPageSeo('process')
const page = await loadPage('process')
---

<Layout title={`${page?.title || 'Our Process'} — DevLab Studios`} seo={seo}>
  {page ? <BlockRenderer blocks={page.blocks} /> : <p class="text-slate-600">This page is not available right now.</p>}
</Layout>
