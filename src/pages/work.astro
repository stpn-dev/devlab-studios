---
import Layout from '../layouts/Layout.astro'
import SectionHeader from '../components/SectionHeader.jsx'
import PrimaryButton from '../components/PrimaryButton.jsx'
import ResponsivePicture from '../components/ResponsivePicture.jsx'
import VectorField from '../components/VectorField.astro'
import { MessageSquare, Briefcase, ArrowRight, Network, Database, Robot } from '../components/icons/icons.js'
import { loadPageSeo } from '../lib/content/seo'
import { loadCaseStudies } from '../lib/content/caseStudies'
import { loadProjects } from '../lib/content/projects'

const seo = await loadPageSeo('work')
const caseStudies = await loadCaseStudies()
const projects = await loadProjects()

const selectedProjectIds = [
  'p10-automated-lead-qualification',
  'p11-wholesaling-buyer-intelligence',
  'p6-messenger-ai-agent',
]

const writeups = {
  'p10-automated-lead-qualification': {
    label: 'Lead operations system',
    challenge: 'Raw property leads needed consistent validation, qualification, calling, and follow-up without losing context between tools.',
    architecture: 'Scheduled intake normalizes and deduplicates records, authenticated Retell calls handle outbound conversations, and post-call webhooks analyze transcripts before routing qualified opportunities to a human acquisitions queue.',
    value: 'The build turns disconnected lead tasks into a monitored flow with explicit validation, failure paths, and a clear human handoff.',
    icon: Robot,
  },
  'p11-wholesaling-buyer-intelligence': {
    label: 'Data enrichment system',
    challenge: 'Buyer research required several location, property, skip-trace, and ranking steps that were difficult to repeat consistently by hand.',
    architecture: 'An n8n workflow geocodes the property, checks a reusable address cache, gathers property and buyer data, normalizes LLC and person contacts, then uses AI-assisted ranking to prepare a focused buyer list.',
    value: 'The system keeps data provenance visible while reducing repetitive research and presenting the team with a cleaner shortlist for review.',
    icon: Database,
  },
  'p6-messenger-ai-agent': {
    label: 'Customer response system',
    challenge: 'Incoming Messenger conversations needed fast, context-aware replies without allowing an AI response step to control the entire workflow.',
    architecture: 'Webhook events are filtered and enriched with conversation context, an AI agent drafts the response, controlled HTTP actions trigger downstream work, and the final message returns through the Messenger flow.',
    value: 'Deterministic workflow steps retain control of routing and integrations while AI handles the language-heavy part of the interaction.',
    icon: Network,
  },
}

const selectedAutomationProjects = selectedProjectIds.flatMap((id) => {
  const project = projects.find((candidate) => candidate.id === id)
  const writeup = writeups[id as keyof typeof writeups]
  return project ? [{ project, writeup }] : []
})
---

<Layout title="Work — DevLab Studios" seo={seo}>
  <div class="space-y-14">
    <section class="cinematic-panel relative overflow-hidden rounded-[2rem] p-6 text-white sm:p-8 lg:p-10">
      <VectorField motif="automation" />
      <div class="relative z-10 max-w-4xl space-y-5">
        <p class="tech-kicker">Selected Work</p>
        <h1 class="text-4xl font-semibold leading-tight text-white sm:text-5xl">Automation systems with the decisions, data flow, and handoff explained.</h1>
        <p class="max-w-3xl text-base leading-relaxed text-slate-300 sm:text-lg">
          Real project write-ups covering the operational problem, system architecture, safeguards, and practical value—not just a gallery of workflow screenshots.
        </p>
        <div class="flex flex-wrap gap-3">
          <PrimaryButton to="#automation-projects">
            <Briefcase size={16} />
            Explore Selected Projects
          </PrimaryButton>
          <PrimaryButton to="/contact" variant="secondary">
            <MessageSquare size={16} />
            Start a Project Conversation
          </PrimaryButton>
        </div>
      </div>
    </section>

    <section id="automation-projects" class="space-y-7 scroll-mt-28">
      <SectionHeader
        title="Selected automation projects"
        subtitle="A closer look at how each system moves from trigger to verified operational handoff."
      />

      <div class="space-y-7">
        {selectedAutomationProjects.map(({ project, writeup }, index) => {
          const ProjectIcon = writeup.icon
          return (
            <article class="light-panel overflow-hidden rounded-[28px]">
              <div class={`grid items-stretch lg:grid-cols-[0.92fr_1.08fr] ${index % 2 === 1 ? 'lg:[&>*:first-child]:order-2' : ''}`}>
                <div class="min-h-[17rem] overflow-hidden border-b border-slate-200 bg-[#0b1026] lg:border-b-0 lg:border-r">
                  <ResponsivePicture
                    image={project.optimizedImage || null}
                    alt={`${project.title} workflow screenshot`}
                    className="h-full min-h-[17rem] w-full object-cover object-center"
                  />
                </div>

                <div class="p-6 sm:p-8 lg:p-10">
                  <div class="flex flex-wrap items-center gap-3">
                    <span class="inline-flex h-10 w-10 items-center justify-center rounded-xl bg-[#e9edff] text-[#2f3cff]">
                      <ProjectIcon size={20} aria-hidden="true" />
                    </span>
                    <p class="text-xs font-bold uppercase tracking-[0.16em] text-[#2f3cff]">{writeup.label}</p>
                  </div>

                  <h2 class="mt-5 text-2xl font-semibold leading-tight text-brand-ink sm:text-3xl">{project.title}</h2>
                  <p class="mt-3 text-sm leading-relaxed text-slate-600">{project.description}</p>

                  <dl class="mt-7 grid gap-5">
                    <div class="border-l-2 border-[#2f3cff] pl-4">
                      <dt class="text-xs font-bold uppercase tracking-[0.14em] text-slate-500">Challenge</dt>
                      <dd class="mt-1 text-sm leading-relaxed text-slate-700">{writeup.challenge}</dd>
                    </div>
                    <div class="border-l-2 border-[#55d8ff] pl-4">
                      <dt class="text-xs font-bold uppercase tracking-[0.14em] text-slate-500">System architecture</dt>
                      <dd class="mt-1 text-sm leading-relaxed text-slate-700">{writeup.architecture}</dd>
                    </div>
                    <div class="border-l-2 border-[#8b96c8] pl-4">
                      <dt class="text-xs font-bold uppercase tracking-[0.14em] text-slate-500">Delivery value</dt>
                      <dd class="mt-1 text-sm leading-relaxed text-slate-700">{writeup.value}</dd>
                    </div>
                  </dl>

                  <div class="mt-7 flex flex-wrap gap-2">
                    {(project.techStack || []).map((technology) => (
                      <span class="rounded-full border border-[#d9def5] bg-[#f7f8fc] px-3 py-1 text-xs font-semibold text-[#344064]">
                        {technology}
                      </span>
                    ))}
                  </div>
                </div>
              </div>
            </article>
          )
        })}
      </div>
    </section>

    {caseStudies.length > 0 ? (
      <section class="space-y-6">
        <SectionHeader title="Client case studies" subtitle="Published engagements with additional context on the problem, delivery, and result." />
        <div class="grid gap-5 sm:grid-cols-2">
          {caseStudies.map((caseStudy) => (
            <a href={`/work/${caseStudy.slug}`} class="light-panel group block overflow-hidden rounded-[24px] p-6 transition hover:-translate-y-1 hover:border-[#2f3cff]/35">
              {caseStudy.industry ? (
                <span class="rounded-full bg-[#e9edff] px-3 py-1 text-xs font-semibold uppercase tracking-[0.14em] text-[#2f3cff]">{caseStudy.industry}</span>
              ) : null}
              <h2 class="mt-3 text-2xl font-semibold text-brand-ink">{caseStudy.title}</h2>
              <p class="mt-2 text-sm leading-relaxed text-slate-600">{caseStudy.summary}</p>
              <span class="mt-5 inline-flex items-center gap-2 text-sm font-semibold text-[#2f3cff]">
                Read case study <ArrowRight size={15} className="transition group-hover:translate-x-1" />
              </span>
            </a>
          ))}
        </div>
      </section>
    ) : null}

    <section class="cinematic-panel rounded-[28px] p-7 text-white sm:p-9">
      <div class="flex flex-col gap-6 md:flex-row md:items-center md:justify-between">
        <div class="max-w-2xl">
          <p class="tech-kicker">From proof to delivery</p>
          <h2 class="mt-3 text-3xl font-semibold">Have a workflow that should operate like a system?</h2>
          <p class="mt-3 text-slate-300">We can map the trigger, rules, data, integrations, failure paths, and human handoff before deciding what should be automated.</p>
        </div>
        <PrimaryButton to="/contact">
          Start a Project <ArrowRight size={16} />
        </PrimaryButton>
      </div>
    </section>
  </div>
</Layout>
