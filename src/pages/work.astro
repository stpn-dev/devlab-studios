---
import Layout from '../layouts/Layout.astro'
import SectionHeader from '../components/SectionHeader.jsx'
import PrimaryButton from '../components/PrimaryButton.jsx'
import WorkProjectGallery from '../components/islands/WorkProjectGallery.jsx'
import VectorField from '../components/VectorField.astro'
import { MessageSquare, Briefcase, ArrowRight, Robot, Code2 } from '../components/icons/icons.js'
import { loadPageSeo } from '../lib/content/seo'
import { loadProjects } from '../lib/content/projects'
import { loadPage } from '../lib/content/pages'

const seo = await loadPageSeo('work')
const projects = await loadProjects()
const workPage = await loadPage('work')
const hero = workPage?.blocks.find((block) => block.type === 'hero')?.props || {}
const showcase = workPage?.blocks.find((block) => block.type === 'workProjectShowcase')?.props || {}
const cta = workPage?.blocks.find((block) => block.type === 'cta')?.props || {}
const projectsById = new Map(projects.map((project) => [project.id, project]))
const selectedProjects = (Array.isArray(showcase.items) ? showcase.items : []).flatMap((item: Record<string, unknown>) => {
  if (item.status !== 'published') return []
  const project = projectsById.get(String(item.projectId || ''))
  return project ? [{ project, narrative: item }] : []
})
const primaryCta = hero.primaryCta as { label?: string; href?: string } | undefined
const secondaryCta = hero.secondaryCta as { label?: string; href?: string } | undefined
const finalCta = cta.primaryCta as { label?: string; href?: string } | undefined
---

<Layout title="Work — DevLab Studios" seo={seo}>
  <div class="space-y-16">
    <section class="cinematic-panel relative overflow-hidden rounded-[2rem] p-6 text-white sm:p-8 lg:p-10">
      <VectorField motif="automation" />
      <div class="relative z-10 max-w-4xl space-y-5">
        <p class="tech-kicker">{String(hero.eyebrow || 'Selected Work')}</p>
        <h1 class="text-4xl font-semibold leading-tight text-white sm:text-5xl">{String(hero.heading || 'Automation systems with the decisions, data flow, and handoff explained.')}</h1>
        <p class="max-w-3xl text-base leading-relaxed text-slate-300 sm:text-lg">
          {String(hero.subheading || '')}
        </p>
        <div class="flex flex-wrap gap-3">
          <PrimaryButton to={primaryCta?.href || '#automation-projects'}>
            <Briefcase size={16} />
            {primaryCta?.label || 'Explore Selected Projects'}
          </PrimaryButton>
          <PrimaryButton to={secondaryCta?.href || '/contact'} variant="secondary">
            <MessageSquare size={16} />
            {secondaryCta?.label || 'Start a Project Conversation'}
          </PrimaryButton>
        </div>
      </div>
    </section>

    <section id="automation-projects" class="space-y-7 scroll-mt-28">
      <SectionHeader
        title={String(showcase.heading || 'Selected automation projects')}
        subtitle={String(showcase.subheading || '')}
      />

      <div class="space-y-7">
        {selectedProjects.map(({ project, narrative }) => {
          const ProjectIcon = project.type === 'Website' ? Code2 : Robot
          return (
            <article class="work-project">
              <div class="flex flex-col">
                <WorkProjectGallery project={project} client:visible />

                <div class="grid gap-8 p-6 sm:p-8 lg:grid-cols-[0.72fr_1.28fr] lg:p-10">
                  <div>
                    <div class="flex flex-wrap items-center gap-3">
                      <span class="inline-flex h-10 w-10 items-center justify-center rounded-xl bg-[#e9edff] text-[#2f3cff]">
                        <ProjectIcon size={20} aria-hidden="true" />
                      </span>
                      <p class="text-xs font-bold uppercase tracking-[0.16em] text-[#2f3cff]">{project.type} system</p>
                    </div>

                    <h2 class="mt-5 text-2xl font-semibold leading-tight text-brand-ink sm:text-3xl">{project.title}</h2>
                    <p class="mt-3 text-sm leading-relaxed text-slate-600">{String(narrative.description || '')}</p>

                    <div class="mt-7 flex flex-wrap gap-2">
                      {(project.techStack || []).map((technology) => (
                        <span class="rounded-full border border-[#d9def5] bg-[#f7f8fc] px-3 py-1 text-xs font-semibold text-[#344064]">
                          {technology}
                        </span>
                      ))}
                    </div>

                    {project.liveUrl !== '#' || project.sourceUrl !== '#' ? (
                      <div class="mt-6 flex flex-wrap gap-4 text-sm font-semibold text-[#2f3cff]">
                        {project.liveUrl && project.liveUrl !== '#' ? (
                          <a href={project.liveUrl} target="_blank" rel="noreferrer" class="inline-flex items-center gap-1.5 hover:underline">
                            View live project <ArrowRight size={14} aria-hidden="true" />
                          </a>
                        ) : null}
                        {project.sourceUrl && project.sourceUrl !== '#' ? (
                          <a href={project.sourceUrl} target="_blank" rel="noreferrer" class="inline-flex items-center gap-1.5 hover:underline">
                            View source <ArrowRight size={14} aria-hidden="true" />
                          </a>
                        ) : null}
                      </div>
                    ) : null}
                  </div>

                  <dl class="grid gap-5 border-t border-slate-200 pt-7 lg:border-l lg:border-t-0 lg:pl-8 lg:pt-0">
                    <div class="border-l-2 border-[#2f3cff] pl-4">
                      <dt class="text-xs font-bold uppercase tracking-[0.14em] text-slate-500">Challenge</dt>
                      <dd class="mt-1 text-sm leading-relaxed text-slate-700">{String(narrative.challenge || '')}</dd>
                    </div>
                    <div class="border-l-2 border-[#55d8ff] pl-4">
                      <dt class="text-xs font-bold uppercase tracking-[0.14em] text-slate-500">System architecture</dt>
                      <dd class="mt-1 text-sm leading-relaxed text-slate-700">{String(narrative.systemArchitecture || '')}</dd>
                    </div>
                    <div class="border-l-2 border-[#8b96c8] pl-4">
                      <dt class="text-xs font-bold uppercase tracking-[0.14em] text-slate-500">Delivery value</dt>
                      <dd class="mt-1 text-sm leading-relaxed text-slate-700">{String(narrative.deliveryValue || '')}</dd>
                    </div>
                  </dl>
                </div>
              </div>
            </article>
          )
        })}
      </div>
    </section>

    <section class="cinematic-panel rounded-[28px] p-7 text-white sm:p-9">
      <div class="flex flex-col gap-6 md:flex-row md:items-center md:justify-between">
        <div class="max-w-2xl">
          <p class="tech-kicker">From proof to delivery</p>
          <h2 class="mt-3 text-3xl font-semibold">{String(cta.heading || 'Have a workflow that should operate like a system?')}</h2>
          <p class="mt-3 text-slate-300">{String(cta.body || '')}</p>
        </div>
        <PrimaryButton to={finalCta?.href || '/contact'}>
          {finalCta?.label || 'Start a Project'} <ArrowRight size={16} />
        </PrimaryButton>
      </div>
    </section>
  </div>
</Layout>
