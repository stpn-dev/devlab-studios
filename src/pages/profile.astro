---
import Layout from '../layouts/Layout.astro'
import SectionHeader from '../components/SectionHeader.jsx'
import PersonalInfoCard from '../components/PersonalInfoCard.jsx'
import SkillsSection from '../components/ui/SkillsSection.jsx'
import SystemsPanel from '../components/ui/SystemsPanel.jsx'
import ToolsMarquee from '../components/ui/ToolsMarquee.jsx'
import ListItemWithIcon from '../components/ui/ListItemWithIcon.jsx'
import AnimatedIcon from '../components/icons/AnimatedIcon.jsx'
import PortfolioGallery from '../components/islands/PortfolioGallery.jsx'
import CertificationsGallery from '../components/islands/CertificationsGallery.jsx'
import { ArrowRight, BadgeCheck, Briefcase, GraduationCap, Trophy } from '../components/icons/icons.js'
import { loadPageSeo } from '../lib/content/seo'
import { loadProfileContent } from '../lib/content/profile'
import { loadProjects } from '../lib/content/projects'
import { optimizeImage } from '../lib/images/optimizeImage'
import { coreTools } from '../data/tools.js'
import profilePhoto from '../assets/recent-photo.png'

const seo = await loadPageSeo('profile')
const profileContent = await loadProfileContent()
const projects = await loadProjects()
const aboutData = profileContent.about || {}
const experiences = profileContent.experiences || []
const certifications = profileContent.certifications || []
const optimizedPhoto = await optimizeImage(profilePhoto, { width: 320, height: 320, fit: 'cover' })
---

<Layout title="Profile — DevLab Studios" seo={seo}>
  <div class="space-y-10">
    <SectionHeader
      title="Profile"
      subtitle="Founder background, technical experience, and selected website and automation projects."
    />

    <PersonalInfoCard aboutData={aboutData} photo={optimizedPhoto} />

    <div class="grid gap-6 lg:grid-cols-2">
      <section class="rounded-[28px] bg-gradient-to-b from-[#fff9ff]/95 via-[#f8f6ff]/90 to-[#f2f0ff]/88 p-6 shadow-[0_18px_45px_rgba(60,28,120,0.14)] sm:p-7">
        <h3 class="text-xl font-semibold text-brand-ink">Career Objectives</h3>
        <p class="mt-3 text-slate-700">{aboutData.careerObjectives}</p>
      </section>
      <section class="rounded-[28px] bg-gradient-to-b from-[#fff9ff]/95 via-[#f8f6ff]/90 to-[#f2f0ff]/88 p-6 shadow-[0_18px_45px_rgba(60,28,120,0.14)] sm:p-7">
        <h3 class="text-xl font-semibold text-brand-ink">Short Bio</h3>
        <p class="mt-3 text-slate-700">{aboutData.shortBio}</p>
      </section>
    </div>

    <div class="grid gap-6 lg:grid-cols-3">
      <section class="rounded-[28px] bg-gradient-to-b from-[#fff9ff]/95 via-[#f8f6ff]/90 to-[#f2f0ff]/88 p-6 shadow-[0_18px_45px_rgba(60,28,120,0.14)] sm:p-7">
        <h3 class="text-xl font-semibold text-brand-ink">Education</h3>
        <ul class="mt-3 space-y-3 text-slate-700">
          {(aboutData.education || []).map((item) => (
            <ListItemWithIcon icon={GraduationCap}>
              <span class="font-bold text-brand-ink">{item.school}</span><br />
              <span>{item.program}</span><br />
              <span class="text-sm text-slate-500">{item.years}</span>
            </ListItemWithIcon>
          ))}
        </ul>
      </section>

      <section class="rounded-[28px] bg-gradient-to-b from-[#fff9ff]/95 via-[#f8f6ff]/90 to-[#f2f0ff]/88 p-6 shadow-[0_18px_45px_rgba(60,28,120,0.14)] sm:p-7 lg:col-span-2">
        <div class="grid gap-6 md:grid-cols-2">
          <div>
            <h3 class="text-xl font-semibold text-brand-ink">Achievements & Responsibilities</h3>
            <ul class="mt-3 space-y-3 text-slate-700">
              {(aboutData.achievementsAndResponsibilities || []).map((item) => (
                <ListItemWithIcon icon={Trophy}>
                  <span class="font-semibold">{item.title}:</span> {item.details}
                </ListItemWithIcon>
              ))}
            </ul>
          </div>
          <div>
            <h3 class="text-xl font-semibold text-brand-ink">Certificates & Licenses</h3>
            <ul class="mt-3 space-y-3 text-slate-700">
              {(aboutData.certificatesAndLicenses || []).map((cert) => (
                <ListItemWithIcon icon={BadgeCheck}>
                  {cert}
                </ListItemWithIcon>
              ))}
            </ul>
          </div>
        </div>
      </section>
    </div>

    {certifications.length > 0 ? (
      <section class="space-y-4">
        <SectionHeader
          title="Platform Certifications"
          subtitle="Automation platform training completed through recognized programs."
        />
        <CertificationsGallery client:visible certifications={certifications} />
      </section>
    ) : null}

    <section class="space-y-4">
      <SectionHeader
        title="Experience"
        subtitle="Roles and work history that shaped my software, automation, and operations background."
      />
      <div class="relative mx-auto max-w-3xl">
        <div class="absolute left-[86px] top-1 bottom-1 w-0.5 bg-gradient-to-b from-brand-teal to-brand-orange" aria-hidden="true"></div>
        <div class="space-y-10">
          {experiences.map((item, index) => (
            <div
              class="grid grid-cols-[72px_20px_1fr] items-center gap-3"
              data-reveal
              data-reveal-delay={index * 90}
            >
              <div class="flex flex-col items-end justify-center rounded-xl bg-gradient-to-br from-brand-teal to-brand-orange px-2.5 py-2 text-right text-white shadow-[0_8px_18px_rgba(122,0,255,0.28)]">
                <span class="text-sm font-bold leading-none">{item.dates}</span>
              </div>
              <div class="flex justify-center">
                <div class="h-3.5 w-3.5 rounded-full border-[3px] border-white bg-brand-orange shadow-[0_0_0_3px_rgba(122,0,255,0.25)]"></div>
              </div>
              <section class="rounded-[28px] bg-gradient-to-b from-[#fff9ff]/95 via-[#f8f6ff]/90 to-[#f2f0ff]/88 p-6 shadow-[0_18px_45px_rgba(60,28,120,0.14)] sm:p-7">
                <div class="mb-2 flex items-center gap-2">
                  <AnimatedIcon icon={Briefcase} size={16} color="text-brand-teal" animationType="none" ariaLabel="Role type" />
                  <p class="text-sm uppercase tracking-[0.14em] text-slate-500">{item.title}</p>
                </div>
                <h3 class="text-2xl font-semibold text-brand-ink">{item.role}</h3>
                <p class="text-slate-700">{item.company}</p>

                <ul class="mt-4 space-y-2 text-slate-700">
                  {item.bullets.map((bullet) => (
                    <li class="flex gap-3 leading-relaxed">
                      <AnimatedIcon icon={ArrowRight} size={16} color="text-brand-teal" animationType="none" className="mt-0.5 flex-shrink-0" />
                      <span>{bullet}</span>
                    </li>
                  ))}
                </ul>
              </section>
            </div>
          ))}
        </div>
      </div>
    </section>

    <SkillsSection
      technicalSkills={profileContent.skills?.technical || []}
      personalSkills={profileContent.skills?.personal || []}
    />

    <section class="space-y-4">
      <SectionHeader
        title="Tools & Platforms"
        subtitle="Technologies and platforms used across delivery, at a glance."
      />
      <ToolsMarquee tools={coreTools} />
    </section>

    <section class="space-y-4">
      <SectionHeader
        title="Systems & Workflows"
        subtitle="Core tools, repeatable workflow patterns, and operating characteristics used across delivery."
      />
      <SystemsPanel
        workflowPatterns={profileContent.workflowPatterns || []}
        systemCharacteristics={profileContent.systemCharacteristics || []}
      />
    </section>

    <section class="space-y-6">
      <SectionHeader
        title="Portfolio"
        subtitle="Selected website buildouts, automation workflows, and interface samples."
      />
      <PortfolioGallery client:visible projects={projects} />
    </section>
  </div>
</Layout>
