---
import Layout from '../../layouts/Layout.astro'
import { loadPageSeo } from '../../lib/content/seo'
import Step1CreateArt from '../../components/pickleball/art/Step1CreateArt.jsx'
import Step2OpenArt from '../../components/pickleball/art/Step2OpenArt.jsx'
import Step3CheckInArt from '../../components/pickleball/art/Step3CheckInArt.jsx'
import Step4QueueArt from '../../components/pickleball/art/Step4QueueArt.jsx'
import Step5AssignArt from '../../components/pickleball/art/Step5AssignArt.jsx'
import Step6StartArt from '../../components/pickleball/art/Step6StartArt.jsx'
import Step7ScoreArt from '../../components/pickleball/art/Step7ScoreArt.jsx'
import Step8FinishArt from '../../components/pickleball/art/Step8FinishArt.jsx'
import Step9CompleteArt from '../../components/pickleball/art/Step9CompleteArt.jsx'
import '../../pickleball-app/pickleball.css'

// Same pattern as every other public page: static defaults from
// src/data/seoContent.js, overridable per-page from the CMS.
const seo = await loadPageSeo('pickleball-how-it-works')

const steps = [
  {
    Art: Step1CreateArt,
    title: 'Create a session',
    body: 'Pick the venue, name the session, choose a scoring ruleset and set the scheduled times. Every court at that venue is added to the session automatically and starts out available.',
    sees: ['A new session in Draft', 'One row per venue court', 'A Queued count and a Courts count'],
  },
  {
    Art: Step2OpenArt,
    title: 'Open it for check-in',
    body: 'Press "Open check-in" under Session actions to move the session out of Draft. Nothing can be assigned to a court until you press "Start session" later — assignment needs a live session.',
    sees: ['An "Open check-in" button under Session actions', 'Status shown as Check-in open', 'The check-in page becomes useful'],
  },
  {
    Art: Step3CheckInArt,
    title: 'Check players in',
    body: 'Check players in one at a time or in bulk as they arrive. Someone who registered but has not arrived is never picked for a court. A late arrival is checked in exactly the same way.',
    sees: ['A running checked-in count', 'Each player’s availability', 'Anyone who has left marked as such'],
  },
  {
    Art: Step4QueueArt,
    title: 'The queue fills',
    body: 'Checking a player in does not queue them. Press "Join queue" for one player, or "Join all to queue" to add everyone checked in and available at once. Once queued, players wait fewest games played first, then longest wait. Going temporarily unavailable does not remove them from the queue; it only skips them for the next court assignment — come back available and they keep the exact spot they already had.',
    sees: ['A "Join queue" action per player, and "Join all to queue" for everyone at once', 'The queue in order', 'How long each player has waited', 'How many games each has played'],
  },
  {
    Art: Step5AssignArt,
    title: 'Assign a court',
    body: 'Press "Start session" to go live, then Assign a free court. The app ranks the queue by fewest games played, then longest wait — and once at least five players are eligible it can swap one of a pair who just played together for another player on the same number of games. Assigning seats the group, splits it into two sides and marks the court ASSIGNED.',
    sees: [
      'A "Recommended next players" list on the first free court',
      'The top fairness reason beside each name',
      'An "Assign" button — it picks and pairs the actual match from that group',
    ],
  },
  {
    Art: Step6StartArt,
    title: 'Start the game',
    body: 'Assigning a court does not start play. Open Games, pick the court under "Ready to start", then choose the serving team and each side\'s starting server. "Start game" stays disabled until both starting servers are picked.',
    sees: [
      'A "Ready to start" list of courts assigned with no game started',
      'A "Serving team" choice, plus a starting server for each side',
      'A "Start game" button that only enables once both are chosen',
    ],
  },
  {
    Art: Step7ScoreArt,
    title: 'Score the game',
    body: 'There are two buttons: which side won the rally. The app works out whether that was a point, a change of server, or a side out, and calls the score. Undo reverses the last rally whenever you need it.',
    sees: ['Both team scores side by side', 'Which team is serving — and, in doubles, which server', 'The official score call'],
  },
  {
    Art: Step8FinishArt,
    title: 'Finish the game',
    body: 'Finish once the score is a valid final under your ruleset. The court is released, the players return to the queue, and the standings update. Got it wrong? Reopen the game, correct it, and finish again — the statistics are recomputed from scratch.',
    sees: ['The final score locked in', 'Standings update, though a player only ranks once they hit the session’s eligible-games threshold — tick "Show provisional players" to see everyone sooner', 'The court free again'],
  },
  {
    Art: Step9CompleteArt,
    title: 'Complete the session',
    body: 'When play is over, complete the session. It is a one-way transition — a completed session can never go back to live, and no further court can be assigned from then on.',
    sees: ['Final standings', 'Status shown as Completed, with no further status actions offered'],
  },
]

const troubles = [
  { title: 'You tapped the wrong side', body: 'Undo the last rally. It is always beside the two rally buttons, and it reverses exactly one action.' },
  { title: 'You noticed a mistake much later', body: 'Reopen the finished game, correct the score, serving side and server number together, then finish it again.' },
  { title: 'A court becomes unusable', body: 'A court can only be taken out of service once it is free — no pending assignment and no game in progress. Release the pending assignment, or finish the game once it reaches a valid final score, then disable the court.' },
]
---

<Layout title="How it works — Devlab Pickleball" seo={seo}>
  <div class="mx-auto max-w-5xl px-6 py-16">
    <p class="text-xs font-bold uppercase tracking-[0.2em] text-slate-400">Guide</p>
    <h1 class="mt-2 text-4xl font-extrabold tracking-tight text-slate-900">How Devlab Pickleball works</h1>
    <div class="pb-rule mt-3 h-[3px] w-11 rounded-full"></div>
    <p class="mt-5 max-w-2xl text-lg leading-relaxed text-slate-600">
      A full run through one session, from creating it to closing it — written for the person
      holding the tablet. Your players never need to read any of this.
    </p>

    <section class="mt-12">
      <h2 class="font-semibold text-slate-900">Find your next step</h2>
      <div class="mt-4 grid gap-4 sm:grid-cols-3" data-testid="pb-guide-jump-links">
        <a href="#run-a-session" class="rounded-2xl bg-white/[0.92] p-5 ring-1 ring-slate-200 transition hover:ring-brand/35">
          <span class="block font-semibold text-brand-ink">Run a session</span>
          <span class="mt-2 block text-sm text-slate-600">Every step from creating the session to closing it.</span>
        </a>
        <a href="#when-something-goes-wrong" class="rounded-2xl bg-white/[0.92] p-5 ring-1 ring-slate-200 transition hover:ring-brand/35">
          <span class="block font-semibold text-brand-ink">Fix a mistake</span>
          <span class="mt-2 block text-sm text-slate-600">Undo a rally, correct a finished game, park a court.</span>
        </a>
        <a href="#what-players-see" class="rounded-2xl bg-white/[0.92] p-5 ring-1 ring-slate-200 transition hover:ring-brand/35">
          <span class="block font-semibold text-brand-ink">What players see</span>
          <span class="mt-2 block text-sm text-slate-600">The QR code, the live view and the TV display.</span>
        </a>
      </div>
    </section>

    <section class="mt-12 rounded-2xl bg-white/[0.92] p-6 ring-1 ring-slate-200">
      <h2 class="font-semibold text-brand-ink">Before you start</h2>
      <p class="mt-2 text-sm leading-relaxed text-slate-600">
        You need a venue with its courts added, and a scoring ruleset. Both are set up once and
        reused by every session afterwards.
      </p>
    </section>

    <section id="run-a-session" class="mt-12 scroll-mt-24 space-y-6" data-testid="pb-guide-steps">
      {steps.map(({ Art, title, body, sees }, index) => (
        <article class="light-artifact overflow-hidden rounded-2xl bg-white/[0.92] ring-1 ring-slate-200">
          <div class="grid gap-0 sm:grid-cols-[0.8fr_1.2fr]">
            <div class="flex items-center justify-center bg-gradient-to-br from-[#fff9ff] to-[#f2efff] p-6" data-testid="pb-artwork">
              <Art className="h-24 w-full text-brand-ink" />
            </div>
            <div class="p-6">
              <p class="pb-score text-sm text-brand">Step {index + 1}</p>
              <h2 class="mt-1 text-xl font-semibold text-brand-ink">{title}</h2>
              <p class="mt-2 text-sm leading-relaxed text-slate-600">{body}</p>
              <ul class="mt-4 space-y-1 text-sm text-slate-600">
                {sees.map((item) => (
                  <li class="flex gap-2"><span class="text-brand" aria-hidden="true">•</span>{item}</li>
                ))}
              </ul>
            </div>
          </div>
        </article>
      ))}
    </section>

    <section id="fixed-pairs" class="mt-16 scroll-mt-24 rounded-2xl bg-white/[0.92] p-6 ring-1 ring-slate-200">
      <h2 class="text-3xl font-semibold text-slate-900">Running a fixed-pairs session</h2>
      <p class="mt-4 max-w-2xl text-sm leading-relaxed text-slate-600">
        Choose "Fixed Pairs" instead of "Open Play" when you create the session, and a few
        things change. It needs a doubles scoring ruleset — there is no such thing as a fixed
        pair in singles.
      </p>
      <ul class="mt-4 space-y-2 text-sm leading-relaxed text-slate-600">
        <li class="flex gap-2"><span class="text-brand" aria-hidden="true">•</span>On the check-in page, select two checked-in players and confirm to form a pair. The pair stays together for the rest of the session.</li>
        <li class="flex gap-2"><span class="text-brand" aria-hidden="true">•</span>The queue moves whole pairs, not individual players — a pair joins, waits and is assigned as one entrant.</li>
        <li class="flex gap-2"><span class="text-brand" aria-hidden="true">•</span>Both partners have to be available for the pair to be offered a court. If one goes temporarily unavailable, the pair gives up its place in the queue; once both are available again, join the queue for the pair again.</li>
        <li class="flex gap-2"><span class="text-brand" aria-hidden="true">•</span>You can't swap one player out of a pair that's already been assigned to a court. Dissolve the pair and form a new one instead.</li>
      </ul>
    </section>

    <section id="when-something-goes-wrong" class="mt-16 scroll-mt-24">
      <h2 class="text-3xl font-semibold text-slate-900">When something goes wrong</h2>
      <div class="mt-8 grid gap-4 lg:grid-cols-2">
        {troubles.map(({ title, body }) => (
          <article class="rounded-2xl bg-white/[0.92] p-5 ring-1 ring-slate-200">
            <h3 class="font-semibold text-brand-ink">{title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-slate-600">{body}</p>
          </article>
        ))}
      </div>
    </section>

    <section id="what-players-see" class="mt-16 scroll-mt-24">
      <h2 class="text-3xl font-semibold text-slate-900">What your players see</h2>
      <div class="mt-8 grid gap-4 sm:grid-cols-3">
        <article class="rounded-2xl bg-white/[0.92] p-5 ring-1 ring-slate-200">
          <h3 class="font-semibold text-brand-ink">Scan a QR code</h3>
          <p class="mt-2 text-sm text-slate-600">Share one code for the session. No sign-in, no install.</p>
        </article>
        <article class="rounded-2xl bg-white/[0.92] p-5 ring-1 ring-slate-200">
          <h3 class="font-semibold text-brand-ink">Follow it live</h3>
          <p class="mt-2 text-sm text-slate-600">Courts and scores update as you record them.</p>
        </article>
        <article class="rounded-2xl bg-white/[0.92] p-5 ring-1 ring-slate-200">
          <h3 class="font-semibold text-brand-ink">Watch on the TV</h3>
          <p class="mt-2 text-sm text-slate-600">A full-screen display for a screen in the hall.</p>
        </article>
      </div>
    </section>

    <section class="mt-16 rounded-2xl bg-white/[0.92] p-6 ring-1 ring-slate-200">
      <h2 class="font-semibold text-brand-ink">Who can do what</h2>
      <ul class="mt-3 space-y-2 text-sm text-slate-600">
        <li><strong class="text-brand-ink">Admin</strong> — everything, plus operators, rulesets and the audit log.</li>
        <li><strong class="text-brand-ink">Facilitator</strong> — runs sessions: check-in, queue, courts, scoring, corrections.</li>
        <li><strong class="text-brand-ink">Scorekeeper</strong> — scores games within a session they've been granted access to.</li>
      </ul>
    </section>

    <div class="mt-16 flex flex-wrap gap-3">
      <a href="/pickleball/app" class="pb-btn-primary inline-flex rounded-lg px-5 py-3 text-sm">Operator sign in</a>
      <a href="/pickleball/methodology" class="inline-flex items-center rounded-lg bg-white/[0.92] px-5 py-3 text-sm font-semibold text-brand-ink ring-1 ring-slate-200">How OPI works</a>
    </div>
  </div>
</Layout>
