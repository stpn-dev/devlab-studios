---
import Layout from '../../layouts/Layout.astro'
import { loadPageSeo } from '../../lib/content/seo'
import { gamePerformance, opi, confidenceTier } from '../../lib/pickleball/opi'
import EligibilityArt from '../../components/pickleball/art/EligibilityArt.jsx'
import ConfidenceArt from '../../components/pickleball/art/ConfidenceArt.jsx'
import RankOrderArt from '../../components/pickleball/art/RankOrderArt.jsx'
import '../../pickleball-app/pickleball.css'

const seo = await loadPageSeo('pickleball-methodology')

// Every figure shown on this page is produced by the same functions the
// scoring engine uses (src/lib/pickleball/opi.ts) rather than typed in as
// prose. A change to the formula therefore changes this page automatically,
// instead of leaving a confidently-worded explanation of the old one — which
// is the usual way a methodology page starts lying.
const RAW_GAMES = [
  { pointsFor: 11, pointsAgainst: 7 },
  { pointsFor: 11, pointsAgainst: 9 },
  { pointsFor: 15, pointsAgainst: 7 },
  { pointsFor: 9, pointsAgainst: 11 },
]

const games = RAW_GAMES.map((game, index) => ({
  ...game,
  label: index + 1,
  total: game.pointsFor + game.pointsAgainst,
  performance: gamePerformance(game.pointsFor, game.pointsAgainst),
  won: game.pointsFor > game.pointsAgainst,
}))

const exampleOpi = opi(games.map((game) => game.performance))
const exampleTier = confidenceTier(games.length)
const firstGame = games[0]

const oneDecimal = (value: number) => value.toFixed(1)

// Ordered widest-to-narrowest so the reader meets the number they will
// actually see on their own card first.
const tiers = [
  { name: 'Established', games: '10 or more', meaning: 'Enough history that one unusual game barely moves it.' },
  { name: 'Developing', games: '3 to 9', meaning: 'A real signal, still sensitive to a single lopsided game.' },
  { name: 'Provisional', games: '0 to 2', meaning: 'Too little history to read as a standing yet.' },
]
---

<Layout title="How OPI works — Devlab Pickleball" seo={seo}>
  <div class="mx-auto max-w-4xl px-6 py-16">
    <h1 class="text-4xl font-extrabold tracking-tight text-slate-900">How OPI works</h1>
    <div class="pb-rule mt-3 h-[3px] w-11 rounded-full"></div>
    <p class="mt-5 max-w-[62ch] text-lg leading-relaxed text-slate-600">
      OPI is the Open Play Performance Index. It asks one question of every game you finish:
      of all the points played, how many were yours? Averaged over your games, that share is
      your OPI — which is why a close loss still counts for something and a narrow win doesn't
      count for much.
    </p>

    <nav class="mt-8 flex flex-wrap gap-x-5 gap-y-2 text-sm" aria-label="On this page">
      <a class="text-navy-200 underline decoration-navy-400/50 underline-offset-4 transition-colors hover:text-white hover:decoration-navy-200" href="#one-game">One game</a>
      <a class="text-navy-200 underline decoration-navy-400/50 underline-offset-4 transition-colors hover:text-white hover:decoration-navy-200" href="#every-game">Every game</a>
      <a class="text-navy-200 underline decoration-navy-400/50 underline-offset-4 transition-colors hover:text-white hover:decoration-navy-200" href="#what-counts">Which games count</a>
      <a class="text-navy-200 underline decoration-navy-400/50 underline-offset-4 transition-colors hover:text-white hover:decoration-navy-200" href="#confidence">How settled it is</a>
      <a class="text-navy-200 underline decoration-navy-400/50 underline-offset-4 transition-colors hover:text-white hover:decoration-navy-200" href="#the-board">How the board is ordered</a>
      <a class="text-navy-200 underline decoration-navy-400/50 underline-offset-4 transition-colors hover:text-white hover:decoration-navy-200" href="#not">What OPI is not</a>
    </nav>

    {/* The one bold surface on the page. Using the product's own scoreboard
        treatment is the point: the formula is a statement about what the
        scoreboard already said. */}
    <section id="one-game" class="pb-scoreboard mt-12 scroll-mt-24 p-6 sm:p-8">
      <h2 class="text-2xl font-semibold">One game, one share</h2>
      <p class="mt-3 max-w-[58ch] text-sm leading-relaxed opacity-80">
        You won this one {firstGame.pointsFor}&ndash;{firstGame.pointsAgainst}. That is
        {' '}{firstGame.total} points played, and {firstGame.pointsFor} of them were yours.
      </p>

      {/* Laid out by the score itself: the flex ratio IS pointsFor:pointsAgainst
          and the tick spacing is one division per point played, so the drawing
          cannot disagree with the numbers beside it — and the bar stays
          countable rather than merely proportional. */}
      <div class="opi-split mt-8" style={`--opi-total: ${firstGame.total}`} aria-hidden="true">
        <div class="opi-split__mine" style={`flex: ${firstGame.pointsFor}`}></div>
        <div class="opi-split__theirs" style={`flex: ${firstGame.pointsAgainst}`}></div>
      </div>
      <div class="mt-2 flex justify-between text-xs font-semibold uppercase tracking-wider opacity-70">
        <span>{firstGame.pointsFor} yours</span>
        <span>{firstGame.pointsAgainst} theirs</span>
      </div>

      <div class="mt-8 flex flex-wrap items-end gap-x-6 gap-y-3 border-t border-white/15 pt-6">
        <p class="font-mono text-sm opacity-80">
          {firstGame.pointsFor} ÷ ({firstGame.pointsFor} + {firstGame.pointsAgainst}) × 100
        </p>
        <p class="pb-score text-5xl leading-none">{oneDecimal(firstGame.performance)}</p>
      </div>
      <p class="mt-3 max-w-[58ch] text-sm leading-relaxed opacity-70">
        In doubles both partners are credited the same share. OPI measures how the pair on your
        side of the net performed, not who hit which winner.
      </p>
    </section>

    <section id="every-game" class="mt-12 scroll-mt-24 rounded-2xl bg-white/[0.92] p-6 ring-1 ring-slate-200 sm:p-8">
      <h2 class="text-2xl font-semibold text-slate-900">Every game, averaged</h2>
      <p class="mt-3 max-w-[62ch] text-sm leading-relaxed text-slate-600">
        Your OPI is the plain average of those shares — every eligible game weighted the same,
        whatever the margin and whoever you played. Four games for this player:
      </p>

      <div class="mt-6 overflow-x-auto">
        <table class="w-full border-collapse text-sm sm:min-w-[34rem]">
          <caption class="sr-only">
            Four finished games, each showing the score, the points played and the resulting
            share, followed by their average.
          </caption>
          <thead>
            <tr class="border-b border-slate-200 text-left text-xs font-semibold uppercase tracking-wider text-slate-500">
              <th scope="col" class="py-2 pr-4 font-semibold">Game</th>
              <th scope="col" class="py-2 pr-4 font-semibold">Score</th>
              <th scope="col" class="hidden py-2 pr-4 font-semibold sm:table-cell">Points played</th>
              <th scope="col" class="py-2 font-semibold">Your share</th>
            </tr>
          </thead>
          <tbody>
            {games.map((game) => (
              <tr class="border-b border-slate-100">
                <th scope="row" class="py-3 pr-4 text-left font-medium text-slate-500">{game.label}</th>
                <td class="whitespace-nowrap py-3 pr-4 tabular-nums text-slate-700">
                  {game.pointsFor}&ndash;{game.pointsAgainst}
                  <span class="ml-2 text-xs text-slate-400">{game.won ? 'won' : 'lost'}</span>
                </td>
                <td class="hidden py-3 pr-4 tabular-nums text-slate-500 sm:table-cell">{game.total}</td>
                <td class="py-3">
                  <div class="flex items-center gap-3">
                    <div class="opi-bar hidden w-full max-w-[11rem] sm:block" aria-hidden="true">
                      <div class="opi-bar__fill" style={`width: ${game.performance}%`}></div>
                    </div>
                    <span class="pb-score shrink-0 tabular-nums text-base text-slate-900 sm:w-14">{oneDecimal(game.performance)}</span>
                  </div>
                </td>
              </tr>
            ))}
          </tbody>
          <tfoot>
            <tr>
              <th scope="row" colspan="3" class="py-4 pr-4 text-left text-sm font-semibold text-slate-900">
                OPI — the average of those {games.length} shares
              </th>
              <td class="py-4">
                <div class="flex items-center gap-3">
                  <div class="opi-bar opi-bar--strong hidden w-full max-w-[11rem] sm:block" aria-hidden="true">
                    <div class="opi-bar__fill" style={`width: ${exampleOpi}%`}></div>
                  </div>
                  <span class="pb-score shrink-0 tabular-nums text-2xl leading-none text-slate-900 sm:w-16">{oneDecimal(exampleOpi)}</span>
                </div>
              </td>
            </tr>
          </tfoot>
        </table>
      </div>

      <p class="mt-5 max-w-[62ch] text-sm leading-relaxed text-slate-600">
        Game 4 was a loss and still contributed {oneDecimal(games[3].performance)}, because
        {' '}{games[3].pointsFor} of the {games[3].total} points played were still yours. Nothing
        here rewards winning as such — only the share of the scoreboard you took.
      </p>
    </section>

    <section id="what-counts" class="mt-12 scroll-mt-24 light-artifact overflow-hidden rounded-2xl bg-white/[0.92] ring-1 ring-slate-200">
      <div class="grid gap-0 sm:grid-cols-[1fr_1.15fr]">
        <div class="flex items-center justify-center bg-gradient-to-br from-[#fff9ff] to-[#f2efff] p-6" data-testid="pb-artwork">
          <EligibilityArt className="h-32 w-full text-brand-ink" />
        </div>
        <div class="p-6 sm:p-8">
          <h2 class="text-2xl font-semibold text-slate-900">Which games count</h2>
          <p class="mt-3 text-sm leading-relaxed text-slate-600">
            A game reaches your average only once it is finished with a valid final score.
          </p>
          <dl class="mt-5 space-y-4 text-sm leading-relaxed">
            <div>
              <dt class="font-semibold text-slate-900">Counts</dt>
              <dd class="mt-1 text-slate-600">Any finished open-play or fixed-pairs game.</dd>
            </div>
            <div>
              <dt class="font-semibold text-slate-900">Does not count</dt>
              <dd class="mt-1 text-slate-600">
                A game still in progress, and every tournament game — a tournament spends your
                OPI on seeding, it never earns it. Reopen a finished game to fix a score and its
                old figures are discarded, not layered on top; finishing it again recomputes the
                average from scratch.
              </dd>
            </div>
          </dl>
        </div>
      </div>
    </section>

    <section id="confidence" class="mt-12 scroll-mt-24 rounded-2xl bg-white/[0.92] p-6 ring-1 ring-slate-200 sm:p-8">
      <h2 class="text-2xl font-semibold text-slate-900">How settled the number is</h2>
      <p class="mt-3 max-w-[62ch] text-sm leading-relaxed text-slate-600">
        An average over three games and one over thirty are not equally trustworthy, so your card
        carries a confidence tier alongside the figure. The tier describes how much history is
        behind the number. It never alters the number, and it never changes where you rank.
      </p>

      <div class="mt-6" data-testid="pb-artwork"><ConfidenceArt className="h-32 w-full text-brand-ink" /></div>

      <dl class="mt-7 divide-y divide-slate-100 border-t border-slate-200">
        {tiers.map((tier) => (
          <div class="flex flex-wrap items-baseline gap-x-4 gap-y-1 py-3">
            <dt class="w-32 shrink-0">
              <span class="rounded-full bg-brand/10 px-2.5 py-1 text-xs font-bold uppercase tracking-wide text-brand">{tier.name}</span>
            </dt>
            <dd class="flex flex-wrap items-baseline gap-x-3 text-sm text-slate-600">
              <span class="tabular-nums font-medium text-slate-900">{tier.games} games</span>
              <span>{tier.meaning}</span>
            </dd>
          </div>
        ))}
      </dl>

      <p class="mt-5 max-w-[62ch] text-sm leading-relaxed text-slate-600">
        The player above has {games.length} eligible games, so their {oneDecimal(exampleOpi)} shows
        as <span class="font-semibold text-slate-900">{exampleTier.toLowerCase()}</span>.
      </p>
    </section>

    <section id="the-board" class="mt-12 scroll-mt-24 rounded-2xl bg-white/[0.92] p-6 ring-1 ring-slate-200 sm:p-8">
      <h2 class="text-2xl font-semibold text-slate-900">How the board is ordered</h2>
      <p class="mt-3 max-w-[62ch] text-sm leading-relaxed text-slate-600">
        The leaderboard sorts on OPI alone, highest first. Everything else you can see on a row
        is there to be read, not to break ties.
      </p>

      <div class="mt-6" data-testid="pb-artwork"><RankOrderArt className="h-40 w-full text-brand-ink" /></div>

      <div class="mt-7 grid gap-6 sm:grid-cols-2">
        <div>
          <h3 class="text-sm font-semibold text-slate-900">Who gets a rank</h3>
          <p class="mt-2 text-sm leading-relaxed text-slate-600">
            Anyone with at least one eligible game who has met the session's minimum. Everyone
            attending still appears on the board from the moment the session opens — players
            below the minimum are listed as present and unranked rather than hidden, ordered by
            how close they are to qualifying, with nobody's first game happening off-screen.
          </p>
        </div>
        <div>
          <h3 class="text-sm font-semibold text-slate-900">Exact ties</h3>
          <p class="mt-2 text-sm leading-relaxed text-slate-600">
            Two identical OPIs are ordered by name, purely so the rows render in a stable order.
            Ties are never broken by games played: turning up for more games must never cost you
            a place, and must never buy you one.
          </p>
        </div>
        <div>
          <h3 class="text-sm font-semibold text-slate-900">What point difference is for</h3>
          <p class="mt-2 text-sm leading-relaxed text-slate-600">
            Your points for and against, and the difference between them, are shown because they
            are worth knowing. None of them feed OPI or the ordering.
          </p>
        </div>
        <div>
          <h3 class="text-sm font-semibold text-slate-900">Session and all-time</h3>
          <p class="mt-2 text-sm leading-relaxed text-slate-600">
            The same formula runs over two scopes: the games in one session, and every eligible
            game you have played. A session board can therefore read quite differently from your
            all-time figure.
          </p>
        </div>
      </div>
    </section>

    <section id="not" class="light-panel mt-12 scroll-mt-24 rounded-2xl p-6 sm:p-8">
      <h2 class="text-xl font-semibold text-slate-900">What OPI is not</h2>
      <p class="mt-3 max-w-[62ch] text-sm leading-relaxed text-slate-600">
        OPI is a Devlab-original metric for open play. It is not an official USA Pickleball
        rating, and it is not DUPR, UTR-P or an Elo system — it does not model your opponents'
        strength, so beating a strong pair and beating a weak one by the same score are worth the
        same. The scoring engine follows standard side-out scoring concepts, but the software is
        not USA-Pickleball-certified.
      </p>
      <p class="mt-4 max-w-[62ch] text-sm leading-relaxed text-slate-600">
        Read it as what it measures: how much of the scoreboard you have been taking lately.
      </p>
    </section>
  </div>
</Layout>

<style>
  /* The two bar treatments this page relies on. Kept here rather than in
     pickleball.css because nothing else in the product renders a share bar,
     and a global utility that exists for exactly one page is harder to
     maintain than a local one. */
  .opi-split {
    position: relative;
    display: flex;
    height: 2.5rem;
    overflow: hidden;
    border-radius: 999px;
  }

  /* One division per point played, driven by --opi-total, so the bar can be
     counted as well as compared. Percentages in a repeating gradient resolve
     against the gradient line, so 100%/total lands a tick on every point. */
  .opi-split::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image: repeating-linear-gradient(
      to right,
      rgba(255, 255, 255, 0.32) 0,
      rgba(255, 255, 255, 0.32) 1px,
      transparent 1px,
      transparent calc(100% / var(--opi-total, 18))
    );
  }

  .opi-split__mine {
    background: var(--brand-gradient);
  }

  /* On the dark scoreboard surface the remainder has to read as "the rest of
     the whole", so it is the same surface lightened rather than a second hue. */
  .opi-split__theirs {
    background: rgba(255, 255, 255, 0.16);
  }

  .opi-bar {
    position: relative;
    height: 0.5rem;
    overflow: hidden;
    border-radius: 999px;
    background: rgba(15, 23, 42, 0.09);
  }

  .opi-bar--strong {
    height: 0.75rem;
  }

  .opi-bar__fill {
    position: absolute;
    inset: 0 auto 0 0;
    border-radius: 999px;
    background: var(--brand-gradient);
  }
</style>
