---
import Layout from '../layouts/Layout.astro'
import SectionHeader from '../components/SectionHeader.jsx'
import PrimaryButton from '../components/PrimaryButton.jsx'
import VectorField from '../components/VectorField.astro'
import * as Icons from '../components/icons/icons.js'
import { ArrowRight, Briefcase, MessageSquare, Shield } from '../components/icons/icons.js'
import { loadPageSeo } from '../lib/content/seo'
import { loadServicesContent } from '../lib/content/services'
import { loadProjects } from '../lib/content/projects'

function resolveIcon(name: string) {
  return (Icons as Record<string, typeof Icons.Lightbulb>)[name] || Icons.Lightbulb
}

function getProjects(projectIds: string[], projectItems: Awaited<ReturnType<typeof loadProjects>>) {
  return projectIds
    .map((id) => projectItems.find((item) => item.id === id))
    .filter((item): item is NonNullable<typeof item> => Boolean(item))
}

const seo = await loadPageSeo('services')
const { solutionGroups, processSteps, faqs } = await loadServicesContent()
const projectItems = await loadProjects()
---

<Layout title="Services — DevLab Studios" seo={seo}>
  <div class="space-y-10">
    <section class="cinematic-panel relative overflow-hidden rounded-[2rem] p-6 text-white sm:p-8 lg:p-10">
      <VectorField motif="automation" />
      <div class="relative z-10 grid gap-8 lg:grid-cols-[1.1fr_0.9fr] lg:items-center">
        <div class="space-y-5">
          <p class="tech-kicker">Services as systems</p>
          <h1 class="text-4xl font-semibold leading-tight text-white sm:text-5xl">
            Full-stack products and AI automation built around real operations.
          </h1>
          <p class="max-w-3xl text-base leading-relaxed text-slate-300 sm:text-lg">
            From the interface customers see to the APIs, data, and automated workflows behind it, every layer is designed as one maintainable system.
          </p>
          <div class="flex flex-wrap gap-3">
            <PrimaryButton to="/contact">
              <MessageSquare size={16} />
              Start a Project
            </PrimaryButton>
            <PrimaryButton to="/profile" variant="secondary">
              <Briefcase size={16} />
              View Project Proof
            </PrimaryButton>
          </div>
        </div>

        <div class="grid gap-4 sm:grid-cols-3 lg:grid-cols-1">
          {processSteps.map((step, index) => {
            const Icon = resolveIcon(step.icon)

            return (
              <article class="rounded-2xl border border-white/10 bg-white/[0.07] p-5 shadow-[0_12px_28px_rgba(4,8,24,0.18)] backdrop-blur-md">
                <div class="flex items-start gap-4">
                  <div class="flex h-11 w-11 flex-shrink-0 items-center justify-center rounded-2xl bg-brand-mint text-brand-teal">
                    <Icon className="h-5 w-5" aria-hidden="true" />
                  </div>
                  <div>
                    <p class="text-xs font-semibold uppercase tracking-[0.16em] text-brand-teal">Step {String(index + 1).padStart(2, '0')}</p>
                    <h3 class="mt-1 font-semibold text-white">{step.title}</h3>
                    <p class="mt-1 text-sm leading-relaxed text-slate-300">{step.description}</p>
                  </div>
                </div>
              </article>
            )
          })}
        </div>
      </div>
    </section>

    <section class="space-y-6">
      <SectionHeader
        title="Solution Categories"
        subtitle="Each category connects to actual project patterns already built across website, automation, API, and AI workflow work."
      />

      <div class="space-y-6">
        {solutionGroups.map((group, index) => {
          const Icon = resolveIcon(group.icon)
          const projects = getProjects(group.projectIds, projectItems)
          const isReversed = index % 2 === 1

          return (
            <article class="overflow-hidden rounded-[28px] bg-gradient-to-br from-[#fff9ff]/95 via-[#f8f6ff]/92 to-[#f2f0ff]/90 shadow-[0_18px_45px_rgba(60,28,120,0.14)]">
              <div class="grid gap-0 lg:grid-cols-[0.95fr_1.05fr] lg:items-stretch">
                <div class={['space-y-5 p-6 sm:p-8', isReversed ? 'lg:order-2' : 'lg:order-1'].join(' ')}>
                  <div class="flex items-center gap-3">
                    <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-brand-mint text-brand-teal">
                      <Icon className="h-5 w-5" aria-hidden="true" />
                    </div>
                    <div>
                      <p class="text-xs font-semibold uppercase tracking-[0.16em] text-brand-teal">{group.eyebrow}</p>
                      <h2 class="text-2xl font-semibold text-brand-ink">{group.title}</h2>
                    </div>
                  </div>
                  <p class="text-slate-700">{group.description}</p>
                  <ul class="grid gap-2 text-sm text-slate-700 sm:grid-cols-2">
                    {group.capabilities.map((capability) => (
                      <li class="flex gap-3 leading-relaxed">
                        <ArrowRight className="mt-0.5 h-4 w-4 flex-shrink-0 text-brand-teal" aria-hidden="true" />
                        <span>{capability}</span>
                      </li>
                    ))}
                  </ul>
                </div>

                <div class={['bg-white/55 p-6 sm:p-8', isReversed ? 'lg:order-1' : 'lg:order-2'].join(' ')}>
                  <p class="text-xs font-semibold uppercase tracking-[0.16em] text-brand-teal">Related project patterns</p>
                  <div class="mt-4 grid gap-3">
                    {projects.map((project) => (
                      <div class="rounded-2xl bg-white/95 p-4 shadow-sm ring-1 ring-slate-200">
                        <div class="flex items-start justify-between gap-3">
                          <div>
                            <h3 class="font-semibold text-brand-ink">{project.title}</h3>
                            <p class="mt-1 line-clamp-2 text-sm text-slate-600">{project.description}</p>
                          </div>
                          <span class="rounded-full bg-brand-mint px-3 py-1 text-xs font-semibold text-brand-teal">{project.type}</span>
                        </div>
                        <div class="mt-3 flex flex-wrap gap-2">
                          {(project.techStack || []).slice(0, 4).map((tech) => (
                            <span class="rounded-full border border-slate-200 bg-[#faf8ff] px-2.5 py-1 text-[0.7rem] font-semibold text-slate-600">
                              {tech}
                            </span>
                          ))}
                        </div>
                      </div>
                    ))}
                  </div>
                </div>
              </div>
            </article>
          )
        })}
      </div>
    </section>

    <section class="rounded-[28px] bg-gradient-to-r from-brand-ink via-[#22185a] to-[#3120a3] p-6 text-white shadow-[0_22px_50px_rgba(20,13,64,0.22)] sm:p-8">
      <div class="grid gap-6 lg:grid-cols-[1fr_0.8fr] lg:items-center">
        <div>
          <p class="text-xs font-semibold uppercase tracking-[0.18em] text-white/70">Not sure where to start?</p>
          <h2 class="mt-2 text-3xl font-semibold">Start with the workflow that loses the most time or opportunities.</h2>
          <p class="mt-3 text-white/75">
            A short discovery conversation can identify whether your best first move is a website, automation, AI agent, internal tool, or backend integration.
          </p>
        </div>
        <div class="flex flex-wrap gap-3 lg:justify-end">
          <PrimaryButton to="/contact">
            <MessageSquare size={16} />
            Start a Project Conversation
          </PrimaryButton>
          <PrimaryButton to="/insights" variant="secondary">
            <Shield size={16} />
            Read Resources
          </PrimaryButton>
        </div>
      </div>
    </section>

    <section class="space-y-5">
      <SectionHeader title="FAQ" subtitle="Common questions about DevLab Studios solution work." />
      <div class="grid gap-4 lg:grid-cols-2">
        {faqs.map((faq) => (
          <article class="rounded-2xl bg-white/92 p-5 shadow-[0_12px_28px_rgba(60,28,120,0.08)] ring-1 ring-slate-200">
            <h3 class="font-semibold text-brand-ink">{faq.question}</h3>
            <p class="mt-2 text-sm leading-relaxed text-slate-600">{faq.answer}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="space-y-4">
      <h3 class="text-center text-lg font-semibold text-brand-ink">Quick Links</h3>
      <div class="grid gap-4 sm:grid-cols-3">
        <a href="/about" class="block rounded-2xl bg-white/90 p-5 text-center shadow-[0_10px_28px_rgba(60,28,120,0.08)] ring-1 ring-slate-200 transition hover:ring-brand-orange/35">
          <p class="text-sm font-semibold text-brand-ink">About</p>
          <p class="mt-1 text-sm text-slate-600">DevLab Studios mission and approach</p>
        </a>
        <a href="/profile" class="block rounded-2xl bg-white/90 p-5 text-center shadow-[0_10px_28px_rgba(60,28,120,0.08)] ring-1 ring-slate-200 transition hover:ring-brand-orange/35">
          <p class="text-sm font-semibold text-brand-ink">Profile</p>
          <p class="mt-1 text-sm text-slate-600">Founder background and project proof</p>
        </a>
        <a href="/contact" class="block rounded-2xl bg-white/90 p-5 text-center shadow-[0_10px_28px_rgba(60,28,120,0.08)] ring-1 ring-slate-200 transition hover:ring-brand-orange/35">
          <p class="text-sm font-semibold text-brand-ink">Contact</p>
          <p class="mt-1 text-sm text-slate-600">Discuss your project or workflow need</p>
        </a>
      </div>
    </section>
  </div>
</Layout>
