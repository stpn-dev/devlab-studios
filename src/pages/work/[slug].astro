---
import Layout from '../../layouts/Layout.astro'
import PrimaryButton from '../../components/PrimaryButton.jsx'
import { ArrowLeft } from '../../components/icons/icons.js'
import { loadCaseStudy } from '../../lib/content/caseStudies'
import type { SeoData } from '../../lib/content/seo'

const { slug } = Astro.params as { slug: string }
const caseStudy = await loadCaseStudy(slug)

if (!caseStudy) {
  Astro.response.status = 404
}

const seo: SeoData | null = caseStudy
  ? {
      metaTitle: `${caseStudy.title} | DevLab Studios Work`,
      metaDescription: caseStudy.summary,
      canonicalUrl: `https://www.devlabstudios.com/work/${caseStudy.slug}`,
      ogTitle: caseStudy.title,
      ogDescription: caseStudy.summary,
      ogImage: caseStudy.coverImageUrl || 'https://www.devlabstudios.com/devlabstudios-logo-only.png',
    }
  : null

const sections: Array<{ title: string; body: string }> = caseStudy
  ? [
      { title: 'Problem', body: caseStudy.problem },
      { title: 'Constraints', body: caseStudy.constraints },
      { title: 'Architecture', body: caseStudy.architecture },
      { title: 'Implementation', body: caseStudy.implementation },
      { title: 'Outcomes', body: caseStudy.outcomes },
    ].filter((section) => section.body)
  : []
---

<Layout title={caseStudy ? caseStudy.title : 'Case study not found'} seo={seo}>
  {!caseStudy ? (
    <div class="rounded-[28px] border border-slate-200 bg-white p-8 text-center shadow-[0_18px_45px_rgba(60,28,120,0.10)]">
      <p class="text-xs font-semibold uppercase tracking-[0.16em] text-brand-teal">Work</p>
      <h1 class="mt-3 text-3xl font-semibold text-brand-ink">Case study not found</h1>
      <p class="mt-3 text-slate-600">This case study is missing or no longer published.</p>
      <div class="mt-6 flex justify-center">
        <PrimaryButton to="/work">
          <ArrowLeft size={16} />
          Back to Work
        </PrimaryButton>
      </div>
    </div>
  ) : (
    <div class="space-y-8">
      <nav class="flex flex-wrap items-center gap-2 text-sm text-slate-500">
        <a href="/work" class="inline-flex items-center gap-2 font-semibold text-brand-teal transition hover:text-brand-tealDark">
          <ArrowLeft className="h-4 w-4" aria-hidden="true" />
          Back to Work
        </a>
        <span>/</span>
        <span>{caseStudy.title}</span>
      </nav>

      <section class="rounded-[28px] bg-gradient-to-br from-brand-mint/55 via-white to-[#f3efff] p-6 shadow-[0_20px_44px_rgba(46,34,98,0.12)] sm:p-8 lg:p-10">
        <div class="space-y-4">
          {caseStudy.industry ? (
            <span class="rounded-full bg-brand-mint px-3 py-1 text-xs font-semibold uppercase tracking-[0.14em] text-brand-teal">{caseStudy.industry}</span>
          ) : null}
          <h1 class="text-4xl font-semibold leading-tight text-brand-ink sm:text-5xl">{caseStudy.title}</h1>
          <p class="max-w-3xl text-base leading-relaxed text-slate-700 sm:text-lg">{caseStudy.summary}</p>
          {caseStudy.clientName ? <p class="text-sm text-slate-500">Client: {caseStudy.clientName}</p> : null}
        </div>
      </section>

      {caseStudy.metrics?.length ? (
        <section class="grid gap-4 sm:grid-cols-3">
          {caseStudy.metrics.map((metric) => (
            <div class="rounded-2xl border border-slate-200 bg-white p-5 text-center shadow-sm">
              <p class="text-2xl font-semibold text-brand-ink">{metric.value}</p>
              <p class="mt-1 text-sm text-slate-500">{metric.label}</p>
            </div>
          ))}
        </section>
      ) : null}

      <div class="space-y-6">
        {sections.map((section) => (
          <article class="rounded-[24px] bg-white p-6 shadow-[0_18px_45px_rgba(60,28,120,0.10)] sm:p-8">
            <h2 class="text-xl font-semibold text-brand-ink">{section.title}</h2>
            <p class="mt-3 leading-relaxed text-slate-700">{section.body}</p>
          </article>
        ))}
      </div>
    </div>
  )}
</Layout>
